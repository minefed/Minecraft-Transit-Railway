+		private static final int CELL_SIZE = 256;
+		private static final long MAX_CELLS = 4096;
+
+		private SpatialIndex(ToLongFunction<T> minXGetter, ToLongFunction<T> minZGetter, ToLongFunction<T> maxXGetter, ToLongFunction<T> maxZGetter) {
+			this.minXGetter = minXGetter;
