+		private void rebuild(Collection<T> data) {
+			orderedData.clear();
+			orderedData.addAll(data);
+			cells.clear();
+			globalIndices.clear();
+			for (int index = 0; index < orderedData.size(); index++) {
+				final T value = orderedData.get(index);
+				final long minCellX = Math.floorDiv(minXGetter.applyAsLong(value), CELL_SIZE);
+				final long minCellZ = Math.floorDiv(minZGetter.applyAsLong(value), CELL_SIZE);
+				final long maxCellX = Math.floorDiv(maxXGetter.applyAsLong(value), CELL_SIZE);
+				final long maxCellZ = Math.floorDiv(maxZGetter.applyAsLong(value), CELL_SIZE);
+				if (!canIndex(minCellX, minCellZ, maxCellX, maxCellZ)) {
+					globalIndices.add(index);
+					continue;
+				}
+				for (long cellX = minCellX; cellX <= maxCellX; cellX++) {
+					for (long cellZ = minCellZ; cellZ <= maxCellZ; cellZ++) {
+						cells.computeIfAbsent(getCellKey(cellX, cellZ), key -> new IntArrayList()).add(index);
+					}
+				}
+			}
+		}
