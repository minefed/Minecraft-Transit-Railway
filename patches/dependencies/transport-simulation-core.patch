+package org.mtr.core.data;
+
+import it.unimi.dsi.fastutil.objects.ObjectArrayList;
+import it.unimi.dsi.fastutil.objects.ObjectOpenHashSet;
+import org.junit.jupiter.api.Test;
+import org.mtr.core.generated.data.VehicleExtraDataSchema;
+import org.mtr.core.serializer.JsonReader;
+import org.mtr.core.tool.Angle;
+import org.mtr.core.tool.Utilities;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+public final class VehicleExtraDataCopyPerformanceTest {
+
+	@Test
+	public void explicitCopyMatchesLegacySerializationRoundTrip() throws ReflectiveOperationException {
+		final Position startPosition = new Position(0, 64, 0);
+		final Position endPosition = new Position(32, 64, 0);
+		final Rail rail = Rail.newRail(
+				startPosition, Angle.values()[0], endPosition, Angle.values()[0], Rail.Shape.QUADRATIC, 0,
+				new ObjectArrayList<>(), 80, 0, false, false, true, false, false, TransportMode.TRAIN
+		);
+		final PathData pathData = new PathData(rail, 3, 4000, 0, startPosition, endPosition);
+		final ObjectArrayList<VehicleCar> vehicleCars = ObjectArrayList.of(new VehicleCar("test_train_1", 20, 3, 4, 16, 0.5, 0.75));
+		final VehicleExtraData source = VehicleExtraData.create(
+				1, 2, 40, vehicleCars, new ObjectArrayList<>(), new ObjectArrayList<>(), new ObjectArrayList<>(), pathData,
+				false, 0.000001, 0.000002, true, 0.001, 5000
+		);
+
+		populateMutableSchemaFields(source);
+		final InterchangeRouteNamesForColor routeNames = new InterchangeRouteNamesForColor(0x123456);
+		routeNames.addRouteName("Local");
+		routeNames.addRouteName("Express");
+		final InterchangeColorsForStationName interchange = new InterchangeColorsForStationName("Central");
+		interchange.addColor(routeNames);
+		getListField("interchangeColorsForStationNameList", source).add(interchange);
+		final ObjectOpenHashSet<VehicleRidingEntity> ridingEntities = new ObjectOpenHashSet<>();
+		ridingEntities.add(new VehicleRidingEntity(UUID.fromString("12345678-1234-5678-1234-567812345678"), 0, 1.25, 2.5, 3.75, true, true, true, false, true, false, true));
+		source.addRidingEntities(ridingEntities);
+
+		final VehicleExtraData legacyCopy = new VehicleExtraData(new JsonReader(Utilities.getJsonObjectFromData(source)));
+		final ObjectArrayList<PathData> legacyPath = getListField("path", legacyCopy);
+		legacyPath.clear();
+		for (int i = 0; i <= source.immutablePath.size(); i++) {
+			if (i == source.immutablePath.size() && !source.immutablePath.isEmpty()) {
+				legacyPath.add(0, source.immutablePath.get(0));
+			} else {
+				final PathData currentPathData = source.immutablePath.get(i);
+				if (i == 0 || currentPathData.getStartDistance() <= source.getStoppingPoint()) {
+					legacyPath.add(currentPathData);
+				} else {
+					break;
+				}
+			}
+		}
+
+		final VehicleExtraData optimizedCopy = source.copy(0);
+		final Field railField = PathData.class.getDeclaredField("rail");
+		railField.setAccessible(true);
+		assertNull(railField.get(legacyCopy.immutablePath.get(0)));
+		assertNull(railField.get(optimizedCopy.immutablePath.get(0)));
+		assertEquals(
+				Utilities.prettyPrint(Utilities.getJsonObjectFromData(legacyCopy)),
+				Utilities.prettyPrint(Utilities.getJsonObjectFromData(optimizedCopy))
+		);
+	}
+
+	private static void populateMutableSchemaFields(VehicleExtraData data) throws IllegalAccessException {
+		long longValue = 100;
+		double doubleValue = 1.25;
+		boolean booleanValue = false;
+		int stringIndex = 0;
+		for (final Field field : VehicleExtraDataSchema.class.getDeclaredFields()) {
+			if (Modifier.isFinal(field.getModifiers())) {
+				continue;
+			}
+			field.setAccessible(true);
+			final Class<?> type = field.getType();
+			if (type == long.class) {
+				field.setLong(data, longValue++);
+			} else if (type == double.class) {
+				field.setDouble(data, doubleValue++);
+			} else if (type == boolean.class) {
+				field.setBoolean(data, booleanValue = !booleanValue);
+			} else if (type == String.class) {
+				field.set(data, "value-" + stringIndex++);
+			} else if (type.isEnum()) {
+				final Object[] values = type.getEnumConstants();
+				field.set(data, values[values.length - 1]);
+			}
+		}
+	}
+
+	@SuppressWarnings("unchecked")
+	private static <T> ObjectArrayList<T> getListField(String name, VehicleExtraData data) throws ReflectiveOperationException {
+		final Field field = VehicleExtraDataSchema.class.getDeclaredField(name);
+		field.setAccessible(true);
+		return (ObjectArrayList<T>) field.get(data);
+	}
+}
