+					(long) Math.ceil(position.getX() + radius), (long) Math.ceil(position.getZ() + radius), consumer
+			);
+		}
+
+		private void forEach(long minX, long minZ, long maxX, long maxZ, Consumer<T> consumer) {
+			final long minCellX = Math.floorDiv(minX, CELL_SIZE);
+			final long minCellZ = Math.floorDiv(minZ, CELL_SIZE);
+			final long maxCellX = Math.floorDiv(maxX, CELL_SIZE);
+			final long maxCellZ = Math.floorDiv(maxZ, CELL_SIZE);
+			if (!canIndex(minCellX, minCellZ, maxCellX, maxCellZ)) {
+				orderedData.forEach(consumer);
+				return;
+			}
+
+			final BitSet candidateIndices = new BitSet(orderedData.size());
+			globalIndices.forEach(candidateIndices::set);
+			for (long cellX = minCellX; cellX <= maxCellX; cellX++) {
+				for (long cellZ = minCellZ; cellZ <= maxCellZ; cellZ++) {
+					final IntArrayList indices = cells.get(getCellKey(cellX, cellZ));
+					if (indices != null) {
+						indices.forEach(candidateIndices::set);
+					}
+				}
+			}
+			for (int index = candidateIndices.nextSetBit(0); index >= 0; index = candidateIndices.nextSetBit(index + 1)) {
+				consumer.accept(orderedData.get(index));
+			}
+		}
+
+		private static boolean canIndex(long minCellX, long minCellZ, long maxCellX, long maxCellZ) {
+			if (minCellX < Integer.MIN_VALUE || maxCellX > Integer.MAX_VALUE || minCellZ < Integer.MIN_VALUE || maxCellZ > Integer.MAX_VALUE) {
+				return false;
+			}
+			final long width = maxCellX - minCellX + 1;
+			final long depth = maxCellZ - minCellZ + 1;
+			return width > 0 && depth > 0 && width <= MAX_CELLS && depth <= MAX_CELLS && width * depth <= MAX_CELLS;
+		}
+
+		private static long getCellKey(long cellX, long cellZ) {
+			return cellX << 32 ^ cellZ & 0xFFFFFFFFL;
+		}
+	}
