--- /dev/null
+++ b/common/build-standalone.gradle
@@ -0,0 +1,46 @@
+plugins {
+	id "java"
+}
+
+group = "org.mtr.mapping"
+version = "0.0.1"
+
+repositories {
+	mavenCentral()
+}
+
+dependencies {
+	compileOnly "com.google.code.findbugs:jsr305:3.0.2"
+	compileOnly "io.netty:netty-buffer:4.1.127.Final"
+	compileOnly "org.apache.logging.log4j:log4j-core:2.25.1"
+	testImplementation "io.netty:netty-buffer:4.1.127.Final"
+	testImplementation "org.apache.logging.log4j:log4j-core:2.25.1"
+	testImplementation "org.junit.jupiter:junit-jupiter:5.13.4"
+	testRuntimeOnly "org.junit.platform:junit-platform-launcher:1.13.4"
+}
+
+sourceSets {
+	test {
+		java.setSrcDirs(["src/test/java"])
+		java.include("org/mtr/mapping/tool/PacketBufferTest.java")
+	}
+}
+
+java {
+	toolchain {
+		languageVersion.set(JavaLanguageVersion.of(21))
+	}
+}
+
+tasks.withType(JavaCompile).configureEach {
+	options.release.set(8)
+}
+
+tasks.withType(AbstractArchiveTask).configureEach {
+	preserveFileTimestamps = false
+	reproducibleFileOrder = true
+}
+
+test {
+	useJUnitPlatform()
+}
