diff --git a/common/src/test/java/org/mtr/mapping/tool/PacketBufferTest.java b/common/src/test/java/org/mtr/mapping/tool/PacketBufferTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..924d33064295254223fce37fde860c61dab9f57a
--- /dev/null
+++ b/common/src/test/java/org/mtr/mapping/tool/PacketBufferTest.java
@@ -0,0 +1,74 @@
+package org.mtr.mapping.tool;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.function.Consumer;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public final class PacketBufferTest {
+
+	@Test
+	public void utf8RoundTripAcrossOutOfOrderFragments() {
+		final StringBuilder stringBuilder = new StringBuilder();
+		for (int i = 0; i < 20000; i++) {
+			stringBuilder.append("Rail-한글-🙂");
+		}
+		final String expected = stringBuilder.toString();
+		final List<ByteBuf> fragments = new ArrayList<>();
+		final PacketBufferSender sender = new PacketBufferSender(Unpooled::buffer);
+		sender.writeString(expected);
+		sender.writeLong(123456789L);
+		sender.send(fragments::add, Runnable::run);
+		assertTrue(fragments.size() > 1);
+
+		final AtomicReference<String> actual = new AtomicReference<>();
+		final AtomicInteger completions = new AtomicInteger();
+		Collections.reverse(fragments);
+		final ByteBuf duplicate = fragments.get(0).copy();
+		final Consumer<PacketBufferReceiver> onComplete = receiver -> {
+			actual.set(receiver.readString());
+			assertEquals(123456789L, receiver.readLong());
+			completions.incrementAndGet();
+		};
+		try {
+			PacketBufferReceiver.receive(duplicate, onComplete, Runnable::run);
+			for (final ByteBuf fragment : fragments) {
+				PacketBufferReceiver.receive(fragment, onComplete, Runnable::run);
+			}
+			assertEquals(expected, actual.get());
+			assertEquals(1, completions.get());
+		} finally {
+			duplicate.release();
+			fragments.forEach(ByteBuf::release);
+		}
+	}
+
+	@Test
+	public void readsLegacyUtf16Strings() {
+		final String expected = "legacy-철도";
+		final ByteBuf fragment = Unpooled.buffer();
+		fragment.writeLong(42);
+		fragment.writeInt(0);
+		fragment.writeInt(1);
+		fragment.writeInt(expected.length());
+		for (int i = 0; i < expected.length(); i++) {
+			fragment.writeChar(expected.charAt(i));
+		}
+		final AtomicReference<String> actual = new AtomicReference<>();
+		try {
+			PacketBufferReceiver.receive(fragment, receiver -> actual.set(receiver.readString()), Runnable::run);
+			assertEquals(expected, actual.get());
+		} finally {
+			fragment.release();
+		}
+	}
+}
